# ==============================================================================
# ENVIRONMENT & CORE APIS
# ==============================================================================
NEXT_PUBLIC_NODE_ENV="development" # Runtime mode: development | production
NEXT_PUBLIC_API_BASE_URL="http://localhost:5000/server-api/v1" # Backend API base URL
NEXT_PUBLIC_CLIENT_BASE_URL="http://localhost:3000" # Storefront customer-facing URL

# ==============================================================================
# AUTH & COOKIE DOMAIN
# ==============================================================================
NEXT_PUBLIC_MAIN_DOMAIN="" # Root domain for shared cross-subdomain auth cookies in production (e.g. yourdomain.com). Leave empty for localhost.
NEXT_PUBLIC_ACCESS_TOKEN_COOKIE_EXPIRES=86400000 # Access token cookie expiry in milliseconds (86400000 = 1 day)
NEXT_PUBLIC_BASE_PATH="" # Optional base path prefix for dashboard routes (leave empty if root)

# ==============================================================================
# CACHE REVALIDATION
# ==============================================================================
NEXT_PUBLIC_REVALIDATE_SECRET="123456" # Shared secret to trigger on-demand cache revalidation on the storefront

# ==============================================================================
# COMPANY INFORMATION
# ==============================================================================
NEXT_PUBLIC_COMPANY_NAME="TechMela" # Store/Company display name (used in invoices, headers, title)
NEXT_PUBLIC_COMPANY_PHONE="017100200300" # Store support phone number (used in printed invoices)
NEXT_PUBLIC_COMPANY_ADDRESS="Dhaka, Bangladesh" # Store physical address (used in printed invoices)

# ==============================================================================
# COURIER / LOGISTICS
# ==============================================================================
NEXT_PUBLIC_COURIER_STATUS_CHECK_URL="https://steadfast.com.bd/t" # External courier parcel tracking URL

# ==============================================================================
# MEDIA UPLOAD CONSTRAINTS
# ==============================================================================
NEXT_PUBLIC_UPLOAD_IMAGE_SIZE=2000000 # Maximum allowed image file size in bytes (2000000 = 2MB)
NEXT_PUBLIC_UPLOAD_IMAGE_MAX_COUNT=10 # Maximum number of images allowed per upload batch
NEXT_PUBLIC_UPLOAD_IMAGE_FORMAT=".jpg,.jpeg,.png,.webp,.JPG,.JPEG,.PNG,.WEBP" # Allowed image extensions

NEXT_PUBLIC_UPLOAD_PDF_SIZE=5000000 # Maximum allowed PDF file size in bytes (5000000 = 5MB)
NEXT_PUBLIC_UPLOAD_PDF_MAX_COUNT=5 # Maximum number of PDFs allowed per upload batch
NEXT_PUBLIC_UPLOAD_PDF_FORMAT=".pdf,.PDF" # Allowed PDF extensions
